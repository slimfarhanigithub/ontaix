<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:ex="http://example.com/acme#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://example.com/acme#Widget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.com/acme#Product"/>
    <rdfs:label xml:lang="en">Widget</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#Order">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.com/acme#Sales"/>
    <rdfs:subClassOf rdf:nodeID="n0ad61df2d4584bec8404e5387195cf0cb2"/>
    <rdfs:label xml:lang="en">Order</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0ad61df2d4584bec8404e5387195cf0cb2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.com/acme#orderDate"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0ad61df2d4584bec8404e5387195cf0cb4">
    <rdf:first rdf:resource="http://example.com/acme#Order"/>
    <rdf:rest rdf:nodeID="n0ad61df2d4584bec8404e5387195cf0cb5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#Acme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Acme Corp</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#places">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">places (0..*)</rdfs:label>
    <rdfs:domain rdf:resource="http://example.com/acme#Customer"/>
    <rdfs:range rdf:resource="http://example.com/acme#Order"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#ExpressOnlineOrder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.com/acme#OnlineOrder"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0ad61df2d4584bec8404e5387195cf0cb5">
    <rdf:first rdf:resource="http://example.com/acme#Delivery"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#Sales">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.com/acme#Acme"/>
    <rdfs:label xml:lang="en">Sales</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#Product">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Product</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0ad61df2d4584bec8404e5387195cf0cb1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.com/acme#prefersProduct"/>
    <owl:someValuesFrom rdf:resource="http://example.com/acme#Product"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#BigCo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.com/acme#Customer"/>
    <rdfs:label xml:lang="en">BigCo</rdfs:label>
    <ex:prefersProduct rdf:resource="http://example.com/acme#Widget"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#OnlineOrder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.com/acme#Order"/>
    <rdfs:label xml:lang="en">Online Order</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#Delivery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.com/acme#Operations"/>
    <rdfs:subClassOf rdf:resource="http://example.com/acme#Sales"/>
    <rdfs:label xml:lang="en">Delivery</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">A tiny synthetic business ontology for the gold importer tests.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#Customer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.com/acme#Sales"/>
    <rdfs:subClassOf rdf:nodeID="n0ad61df2d4584bec8404e5387195cf0cb1"/>
    <owl:disjointWith rdf:resource="http://example.com/acme#Product"/>
    <rdfs:label xml:lang="en">Customer</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#containsItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">contains</rdfs:label>
    <rdfs:domain rdf:nodeID="n0ad61df2d4584bec8404e5387195cf0cb3"/>
    <rdfs:range rdf:resource="http://example.com/acme#Product"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#shipsProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.com/acme#Delivery"/>
    <rdfs:range rdf:resource="http://example.com/acme#Product"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#orderDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.com/acme#Order"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0ad61df2d4584bec8404e5387195cf0cb3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n0ad61df2d4584bec8404e5387195cf0cb4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#Operations">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.com/acme#Acme"/>
    <rdfs:label xml:lang="en">Operations</rdfs:label>
    <rdfs:label xml:lang="fr">Opérations</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/acme#prefersProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
</rdf:RDF>
