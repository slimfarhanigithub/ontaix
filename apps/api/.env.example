# Copy to .env for local runs. Every variable is optional; defaults live in app/config.py.
ONTAIX_ENVIRONMENT=dev
ONTAIX_LOG_LEVEL=INFO
ONTAIX_DATABASE_URL=
# Seeds the API's random source for reproducible renders in test mode; unset in production.
ONTAIX_TEST_SEED=
# Tests use this PostgreSQL instead of starting an embedded one.
ONTAIX_TEST_DATABASE_URL=
# Teach extraction model step. Without a key the teach bar uses the grammar alone.
ONTAIX_LLM_PROVIDER=anthropic
ONTAIX_LLM_MODEL=claude-sonnet-5
# Wall clock per typed or document sentence, connect included; above 15 or at most 0 stops start-up.
ONTAIX_LLM_TIMEOUT_SECONDS=15
# The same for a whole speech transcript; above 45 or at most 0 stops start-up.
ONTAIX_LLM_SPEECH_TIMEOUT_SECONDS=45
ONTAIX_LLM_CALLS_PER_HOUR=200
# Set locally only; in Azure the key is read from Key Vault. Never commit a value.
ONTAIX_ANTHROPIC_API_KEY=
