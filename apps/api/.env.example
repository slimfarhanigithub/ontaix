# Copy to .env for local runs. Every variable is optional; defaults live in app/config.py.
ONTAIX_ENVIRONMENT=dev
ONTAIX_LOG_LEVEL=INFO
ONTAIX_DATABASE_URL=
# Seeds the API's random source for reproducible renders in test mode; unset in production.
# ONTAIX_TEST_SEED=42
# `python -m app.seed`: empty (the tenant and its users only) or fixture (the Northwind and Aurora
# example). `pnpm dev:stack` passes empty unless this is set.
# ONTAIX_SEED=fixture
# Tests use this PostgreSQL instead of starting an embedded one.
ONTAIX_TEST_DATABASE_URL=
# Teach extraction model step: azure_foundry (default) or anthropic. Without an endpoint (Foundry)
# or a key (Anthropic) the teach bar uses the grammar alone.
ONTAIX_LLM_PROVIDER=azure_foundry
# The Foundry resource endpoint (Terraform output), for example https://<resource>.cognitiveservices.azure.com.
# Keyless: the API signs in with DefaultAzureCredential, locally your `az login` session.
ONTAIX_FOUNDRY_ENDPOINT=
ONTAIX_FOUNDRY_DEPLOYMENT=gpt-6-sol
# Lowest reasoning effort: none, minimal, low, medium or high.
ONTAIX_FOUNDRY_REASONING_EFFORT=none
# Output tokens added to the 1,024 (12,288 for speech) answer bound when the model reasons anyway.
ONTAIX_LLM_REASONING_ALLOWANCE_TOKENS=0
# Recorded in llm_call.model and looked up in the price table; with anthropic, the model id sent.
ONTAIX_LLM_MODEL=gpt-6-sol
# Euros per million tokens per model. PLACEHOLDER prices for local runs only: set the published
# Azure retail price of gpt-6-sol DataZoneStandard (France Central) in real deployments.
# Start-up stops when a configured provider's model has no entry.
ONTAIX_LLM_PRICE_TABLE={"gpt-6-sol": {"inputEurPerMTok": 1.00, "outputEurPerMTok": 8.00}}
# Wall clock per typed or document sentence, token and connect included; above 15 or at most 0
# stops start-up.
ONTAIX_LLM_TIMEOUT_SECONDS=15
# The same for a whole speech transcript; above 45 or at most 0 stops start-up.
ONTAIX_LLM_SPEECH_TIMEOUT_SECONDS=45
ONTAIX_LLM_CALLS_PER_HOUR=200
# anthropic only. Set locally only; in Azure the key is read from Key Vault. Never commit a value.
ONTAIX_ANTHROPIC_API_KEY=
