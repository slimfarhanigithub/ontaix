# Copy to .env for local runs. Every variable is optional; defaults live in app/config.py.
ONTAIX_ENVIRONMENT=dev
ONTAIX_LOG_LEVEL=INFO
ONTAIX_DATABASE_URL=
# Organization requests connect with ONTAIX_DATABASE_URL and switch to the role ontaix_app;
# sign-in, the platform portal and cross-organization jobs use this login (default: the same one)
# and switch to ontaix_platform. Each login must be a member of the role it switches to.
# ONTAIX_PLATFORM_DATABASE_URL=
# The API's own login, for `python -m app.admin ensure-api-login` run with the schema owner's
# login in ONTAIX_DATABASE_URL: the login named here is created with this URL's password and
# granted the two roles. Set for that command only, never for the API process.
# ONTAIX_API_DATABASE_URL=
# Accept the X-Ontaix-User development header. Only in dev or test; the API refuses to start with
# it on anywhere else. Off by default, so a deployed environment named dev accepts no header.
# ONTAIX_DEV_IDENTITY_HEADER=true
# Origins allowed to sign in and to send cookie-authenticated writes (JSON list).
# ONTAIX_ALLOWED_ORIGINS=["http://localhost:5173"]
# Proxies whose X-Forwarded-For entry is trusted for the client IP (the sign-in throttle): 1 behind
# the ingress, 0 when the API is reached directly.
# ONTAIX_TRUSTED_PROXY_HOPS=0
# Seeds the API's random source for reproducible renders in test mode; unset in production.
# ONTAIX_TEST_SEED=42
# `python -m app.seed`: empty (the tenant and its users only) or fixture (the Northwind and Aurora
# example). `pnpm dev:stack` passes empty unless this is set.
# ONTAIX_SEED=fixture
# Tests use this PostgreSQL instead of starting an embedded one.
ONTAIX_TEST_DATABASE_URL=
# Teach extraction model step: azure_foundry (default) or anthropic. Without an endpoint (Foundry)
# or a key (Anthropic) the teach bar uses the grammar alone.
ONTAIX_LLM_PROVIDER=azure_foundry
# The Foundry resource endpoint (Terraform output), for example https://<resource>.cognitiveservices.azure.com.
# Keyless: the API signs in with DefaultAzureCredential, locally your `az login` session.
ONTAIX_FOUNDRY_ENDPOINT=
ONTAIX_FOUNDRY_DEPLOYMENT=gpt-6-sol
# Lowest reasoning effort: none, minimal, low, medium or high.
ONTAIX_FOUNDRY_REASONING_EFFORT=none
# Output tokens added to the 1,024 (12,288 for speech) answer bound when the model reasons anyway.
ONTAIX_LLM_REASONING_ALLOWANCE_TOKENS=0
# anthropic: the model id sent, recorded in llm_call.model and priced. The Foundry providers record
# and price the deployment they call.
ONTAIX_LLM_MODEL=gpt-6-sol
# Euros per million tokens per model. PLACEHOLDER prices for local runs only: set the published
# Azure retail price of gpt-6-sol DataZoneStandard (France Central) in real deployments.
# Start-up stops when a model a configured provider calls has no entry.
ONTAIX_LLM_PRICE_TABLE={"gpt-6-sol": {"inputEurPerMTok": 1.00, "outputEurPerMTok": 8.00}}
# Wall clock per typed or document sentence, token and connect included; above 15 or at most 0
# stops start-up.
ONTAIX_LLM_TIMEOUT_SECONDS=15
# The same for a whole speech transcript; above 45 or at most 0 stops start-up.
ONTAIX_LLM_SPEECH_TIMEOUT_SECONDS=45
ONTAIX_LLM_CALLS_PER_HOUR=200
# Claude on Azure AI Foundry (deployments claude-fable-5-1, claude-sonnet-5-5, claude-sonnet-5): uncomment to replace the block
# above. Endpoint is the Terraform output foundry_claude_endpoint; keyless like azure_foundry.
# GlobalStandard: prompts may be processed outside the EU data zone. Prices are Anthropic's USD list
# prices at 0.86 EUR per USD; the Sonnet 5 price is a conservative placeholder.
# Two profiles. live (typed text and speech, latency first) uses the settings without DEEP; deep
# (document sentences) uses the DEEP settings, each one left unset taking its live value. Fable
# takes no `none` effort; `low` is its fastest, with room for its thinking tokens. The price table
# needs an entry for each deployment.
# ONTAIX_LLM_PROVIDER=anthropic_foundry
# ONTAIX_FOUNDRY_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# ONTAIX_FOUNDRY_DEPLOYMENT=claude-sonnet-5
# ONTAIX_FOUNDRY_REASONING_EFFORT=none
# ONTAIX_LLM_REASONING_ALLOWANCE_TOKENS=0
# ONTAIX_FOUNDRY_DEEP_DEPLOYMENT=claude-fable-5-1
# ONTAIX_FOUNDRY_DEEP_REASONING_EFFORT=low
# ONTAIX_LLM_DEEP_REASONING_ALLOWANCE_TOKENS=4096
# ONTAIX_LLM_PRICE_TABLE={"claude-sonnet-5": {"inputEurPerMTok": 3.44, "outputEurPerMTok": 17.2}, "claude-fable-5-1": {"inputEurPerMTok": 8.6, "outputEurPerMTok": 43.0}}
# anthropic only. Set locally only; in Azure the key is read from Key Vault. Never commit a value.
ONTAIX_ANTHROPIC_API_KEY=
# Speech recognition for the teach bar microphone (Azure AI Speech, France Central). Keyless: the
# API takes an Entra token and exchanges it server-side at the resource's sts/v1.0/issueToken
# endpoint; the browser receives only that Speech token (about 10 minutes, this resource only).
# The Entra token comes from the managed identity whose client id is ONTAIX_SPEECH_CLIENT_ID (in
# the cluster, through workload identity). Leave ONTAIX_SPEECH_CLIENT_ID empty on your laptop: in
# dev, and only when AZURE_FEDERATED_TOKEN_FILE is unset, your `az login` is used instead; it
# needs Cognitive Services User on the Speech resource (Terraform assigns it to the owner).
# Unset resource id or endpoint, or a failed exchange: the API answers 503 and the Studio uses
# the browser's recogniser. Values are the Terraform outputs speech_resource_id, speech_region,
# speech_endpoint and speech_identity_client_id.
ONTAIX_SPEECH_RESOURCE_ID=
ONTAIX_SPEECH_REGION=francecentral
ONTAIX_SPEECH_ENDPOINT=
ONTAIX_SPEECH_CLIENT_ID=
# en-GB or en-US; anything else stops start-up.
ONTAIX_SPEECH_LANGUAGE=en-GB
ONTAIX_SPEECH_TOKENS_PER_HOUR=60
# Usage learning: lessons per company from people's approvals, rejections and corrections, sent
# back to the model as data. The deployment switch (false stops all capture and retrieval; the
# eval harness sets it false), the token budget of lessons per model call, and how long after a
# rejection a re-teach outside the same session still counts as a correction.
ONTAIX_LEARNING_ENABLED=true
ONTAIX_LEARNING_CONTEXT_TOKENS=1500
ONTAIX_LEARNING_CORRECTION_WINDOW_MINUTES=10
