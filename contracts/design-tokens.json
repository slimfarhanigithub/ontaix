      "dim-alpha": { "$type": "number", "$value": 0.2 },
      "coverage-unbound-alpha": { "$type": "number", "$value": 0.38 },
      "pending-link-alpha": { "$type": "number", "$value": 0.55 },
      "neck": {
        "edge-mix-black": { "$type": "number", "$value": 0.38 },
        "stop-0-35-mix-white": { "$type": "number", "$value": 0.16 },
        "stop-0-65": { "$type": "string", "$value": "col" }
      },
      "source-square": {
        "gradient-start-mix-white": { "$type": "number", "$value": 0.2 },
        "gradient-end-mix-black": { "$type": "number", "$value": 0.35 },
        "stroke-mix-white": { "$type": "number", "$value": 0.35 },
        "corner-radius": { "$type": "dimension", "$value": "7px" }
      },
      "label-chip": {
        "radius": { "$type": "dimension", "$value": "9px" },
        "height": { "$type": "dimension", "$value": "18px" }
      },
      "lineage-link-width": { "$type": "number", "$value": 2.2 },
      "bind-link-width": { "$type": "number", "$value": 1 }
    },
    "links": {
      "isa-dash": { "$type": "string", "$value": "[6,5]" },
      "same-dash": { "$type": "string", "$value": "[2,5]" },
      "curve-bend": { "$type": "string", "$value": "(seed-0.5)*0.3" },
      "clash-jitter": { "$type": "number", "$value": 7 }
    }
  },
  "semantic": {
    "$type": "color",
    "green": { "$value": "#4fc98f", "$description": "GREEN: approval rim, toggle dot, state dots, audit approved, wizard Connected." },
    "red": { "$value": "#d95a68", "$description": "RED / C.conflict / --conflict: rejection fade, conflict links, danger hover, audit rejected." },
