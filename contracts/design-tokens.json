{
  "$description": "Ontaix Studio design tokens. Every value is verbatim from reference/ontaix-studio-reference.html; the Studio generates its :root custom properties and its canvas theme object from this file. rgba() and CSS function values are kept as the reference writes them because pixel parity outranks token-format purity.",
  "font": {
    "$type": "fontFamily",
    "family": { "$value": "'Sora',ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif" },
    "mono": { "$value": "ui-monospace, Menlo, Consolas, monospace" },
    "weights": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "source": { "$type": "string", "$value": "https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600&display=swap" }
  },
  "css": {
    "$description": "CSS custom properties on :root. data-theme=\"dark\" or \"light\" on <html> selects the set.",
    "dark": {
      "$type": "color",
      "bg": { "$value": "#070b16" },
      "panel": { "$value": "rgba(12,17,34,.78)" },
      "ink": { "$value": "#eef2fb" },
      "ink-2": { "$value": "#a9b3cc" },
      "ink-3": { "$value": "#6b7794" },
      "line": { "$value": "rgba(170,180,204,.16)" },
      "accent": { "$value": "#3fb8a9", "$description": "Settable through the Appearance page (SETTINGS.accent)." },
      "conflict": { "$value": "#d95a68" }
    },
    "light": {
      "$type": "color",
      "bg": { "$value": "#eef1f7" },
      "panel": { "$value": "rgba(255,255,255,.88)" },
      "ink": { "$value": "#141a2e" },
      "ink-2": { "$value": "#465070" },
      "ink-3": { "$value": "#7a849e" },
      "line": { "$value": "rgba(20,26,46,.12)" },
      "accent": { "$value": "#3fb8a9" },
      "conflict": { "$value": "#d95a68" }
    },
    "font": { "$type": "fontFamily", "$value": "{font.family}" },
    "panel-w": { "$type": "dimension", "$value": "320px", "$description": "0px when the panel is hidden or the viewport is at most 900px." }
  },
  "canvas": {
