  "canvas": {
    "theme": {
      "$description": "THEMES object consumed by the canvas renderer, derived from the css tokens of the applied theme (apps/studio/src/canvas/themes.ts): bg = --bg, INK = --text, INK2 = --text-2, CHIP = --surface as rgb triplets, shadow = --bg at alpha .85, vignette = --bg mixed toward black (12 percent at alpha .5 in light, 35 percent at alpha .8 in dark), hull = --text. Only the alphas are fixed per theme.",
      "dark": {
        "hullA": {
          "$type": "number",
          "$value": 0.055
        },
        "domA": {
          "$type": "number",
          "$value": 0.075
        },
        "domFocusA": {
          "$type": "number",
          "$value": 0.12
        }
      },
      "light": {
        "hullA": {
          "$type": "number",
          "$value": 0.05
        },
        "domA": {
          "$type": "number",
          "$value": 0.13
        },
        "domFocusA": {
          "$type": "number",
          "$value": 0.2
        }
      }
    },
    "background": {
      "glow": {
        "$description": "Radial gradient centred at (CX, 0.45H), radius max(W,H)*0.7.",
        "centre-y-factor": {
          "$type": "number",
          "$value": 0.45
        },
        "radius-factor": {
          "$type": "number",
          "$value": 0.7
        },
        "stop-0": {
          "$type": "string",
          "$value": "{css.light.accent} at alpha 0.04 (the applied theme's --accent)"
        },
        "stop-0-6": {
          "$type": "string",
          "$value": "{css.light.link} at alpha 0.025 (the applied theme's --link)"
        },
        "stop-1": {
          "$type": "string",
          "$value": "rgba({canvas.theme.CHIP},0)",
          "$description": "Transparent surface colour of the applied theme."
        }
      },
      "vignette": {
        "inner-radius-factor": {
          "$type": "number",
          "$value": 0.35,
          "$description": "min(W,H)*0.35, transparent"
        },
        "outer-radius-factor": {
          "$type": "number",
          "$value": 0.75,
          "$description": "max(W,H)*0.75, theme vignette colour"
        }
      },
      "region-pass-scale": {
        "$type": "number",
        "$value": 0.5,
        "$description": "OFFS: regions render at half resolution."
      }
    },
    "regions": {
      "company-hull-pad": {
        "$type": "dimension",
        "$value": "175px"
      },
      "domain-hull-pad": {
        "$type": "dimension",
        "$value": "86px"
      },
      "hull-stroke-factor": {
        "$type": "number",
        "$value": 2,
        "$description": "lineWidth = pad*2 plus fill."
      },
      "domain-unfocused-mix": {
        "$type": "number",
        "$value": 0.55,
        "$description": "Non-focused domains mixed 55 percent toward the applied theme's --bg."
      }
    },
    "cell": {
