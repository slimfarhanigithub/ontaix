        "INK": { "$type": "string", "$value": "238,242,251" },
        "INK2": { "$type": "string", "$value": "169,179,204" },
        "CHIP": { "$type": "string", "$value": "7,11,22" },
        "shadow": { "$type": "color", "$value": "rgba(0,0,0,0.7)" },
        "vignette": { "$type": "color", "$value": "rgba(3,5,12,0.8)" },
        "hull": { "$type": "color", "$value": "#dfe6ff" },
        "hullA": { "$type": "number", "$value": 0.055 },
        "domA": { "$type": "number", "$value": 0.075 },
        "domFocusA": { "$type": "number", "$value": 0.12 }
      },
      "light": {
        "bg": { "$type": "color", "$value": "#eef1f7" },
        "INK": { "$type": "string", "$value": "20,26,46" },
        "INK2": { "$type": "string", "$value": "74,84,112" },
        "CHIP": { "$type": "string", "$value": "255,255,255" },
        "shadow": { "$type": "color", "$value": "rgba(255,255,255,0.85)" },
        "vignette": { "$type": "color", "$value": "rgba(200,206,222,0.55)" },
        "hull": { "$type": "color", "$value": "#5b6690" },
        "hullA": { "$type": "number", "$value": 0.05 },
        "domA": { "$type": "number", "$value": 0.13 },
        "domFocusA": { "$type": "number", "$value": 0.2 }
      }
    },
    "background": {
      "glow": {
        "$description": "Radial gradient centred at (CX, 0.45H), radius max(W,H)*0.7.",
        "centre-y-factor": { "$type": "number", "$value": 0.45 },
        "radius-factor": { "$type": "number", "$value": 0.7 },
        "stop-0": { "$type": "color", "$value": "rgba(63,184,169,0.04)" },
        "stop-0-6": { "$type": "color", "$value": "rgba(139,134,207,0.025)" },
        "stop-1": { "$type": "string", "$value": "rgba({canvas.theme.dark.CHIP},0)", "$description": "Transparent chip colour of the active theme." }
      },
      "vignette": {
        "inner-radius-factor": { "$type": "number", "$value": 0.35, "$description": "min(W,H)*0.35, transparent" },
        "outer-radius-factor": { "$type": "number", "$value": 0.75, "$description": "max(W,H)*0.75, theme vignette colour" }
      },
      "region-pass-scale": { "$type": "number", "$value": 0.5, "$description": "OFFS: regions render at half resolution." }
    },
    "regions": {
      "company-hull-pad": { "$type": "dimension", "$value": "175px" },
      "domain-hull-pad": { "$type": "dimension", "$value": "86px" },
      "hull-stroke-factor": { "$type": "number", "$value": 2, "$description": "lineWidth = pad*2 plus fill." },
      "domain-unfocused-mix": { "$type": "number", "$value": 0.55, "$description": "Non-focused domains mixed 55 percent toward #070b16 in both themes." },
      "domain-unfocused-mix-target": { "$type": "color", "$value": "#070b16" }
    },
    "cell": {
      "radius": { "$type": "number", "$value": 24 },
      "source-radius": { "$type": "number", "$value": 16 },
      "gradient": {
        "highlight-mix-white": { "$type": "number", "$value": 0.55 },
        "stop-0-3-mix-white": { "$type": "number", "$value": 0.18 },
        "stop-0-75": { "$type": "string", "$value": "col" },
        "rim-mix-black": { "$type": "number", "$value": 0.42 },
        "rim-mix-black-fused": { "$type": "number", "$value": 0.38 }
      },
      "rim": {
        "stroke-mix-white": { "$type": "number", "$value": 0.35 },
        "alpha": { "$type": "number", "$value": 0.35 },
        "alpha-hover": { "$type": "number", "$value": 0.7 },
        "width": { "$type": "number", "$value": 1 },
        "width-hover": { "$type": "number", "$value": 1.6 },
        "width-flash": { "$type": "number", "$value": 1.8 },
        "flash-alpha": { "$type": "number", "$value": 0.9 }
      },
      "pending-alpha": { "$type": "number", "$value": 0.62 },
