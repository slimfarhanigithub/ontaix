# Copy to .env in this folder. Placeholder names only; real values are never committed.
POSTGRES_USER=ontaix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ontaix
ONTAIX_ENVIRONMENT=dev
# Accept the X-Ontaix-User development header (dev and test only; never set it elsewhere).
ONTAIX_DEV_IDENTITY_HEADER=true
ONTAIX_LOG_LEVEL=INFO
